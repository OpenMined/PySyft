[group('terraform')]
tf-plan *args:
    #!/bin/bash
    set -e
    {{tf_preflight}}
    terraform -chdir={{tf_dir}} plan -var=dev_mode=false {{args}}

# Deploy a production enclave (hardened image, no SSH, encryption on)
[group('terraform')]
tf-apply *args:
