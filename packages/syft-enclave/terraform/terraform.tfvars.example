# Copy to terraform.tfvars (gitignored) and fill in.
# Do NOT set dev_mode here — it is forced on the command line by
# `just tf-apply` (false) and `just tf-apply-dev` (true).

project_id    = "my-gcp-project"
zone          = "us-central1-a"
enclave_email = "enclave@example.org"
data_owners   = ["do1@openmined.org", "do2@openmined.org"]
token_file    = "/absolute/path/to/token_enclave.json"

# --- optional overrides (defaults shown) ---
# vm_name             = "syft-enclave-vm"
# machine_type        = "n2d-standard-2"
# boot_disk_size_gb   = 200
# container_image     = "docker.io/openminedreleasebot/syft-client-enclave:latest"
# use_encryption      = false         # dev-mode override only (default false); production always encrypts
# job_timeout_seconds = 2592000   # 30 days (default); set to null to use the container default (600s)
