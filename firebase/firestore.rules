rules_version = '2';

// Access rules for syft's WebRTC signaling and peering.
// Each path holds emails in lower case.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function isUser(email) {
      return isSignedIn() && request.auth.token.email.lower() == email;
    }

    // Each client writes its own presence. Each signed-in client can get it,
    // but no client can list the presence of all clients.
    match /presence/{email} {
      allow get: if isSignedIn();
      allow delete: if isUser(email);
      allow create, update: if isUser(email)
        && request.resource.data.keys().hasOnly(['session', 'last_seen'])
        && request.resource.data.session is string
        && request.resource.data.last_seen == request.time;
    }

    // Offers, answers and refusals for one client. Any signed-in client can
    // send one, under its own email. Only the receiver reads and deletes them.
    match /inbox/{email}/signals/{signal} {
      allow read, delete: if isUser(email);
      allow create: if isSignedIn()
        && request.resource.data.from.lower() == request.auth.token.email.lower()
        && request.resource.data.request is string
        && request.resource.data.created_at == request.time
        && ((request.resource.data.type in ['offer', 'answer']
             && request.resource.data.keys().hasOnly(
               ['type', 'from', 'request', 'sdp', 'created_at'])
             && request.resource.data.sdp is string)
          || (request.resource.data.type == 'refuse'
             && request.resource.data.keys().hasOnly(
               ['type', 'from', 'request', 'reason', 'created_at'])
             && request.resource.data.reason is string));
    }

    // A request from sender to peer with email. It names the sender, as the
    // path does.
    match /peer_requests/{email}/from/{sender} {
      allow read: if isUser(email) || isUser(sender);
      allow create, update: if isUser(sender)
        && request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email.lower() == sender;
    }

    // What owner shares with reader: a key bundle and the peer info.
    match /shared/{owner}/with/{reader} {
      allow read: if isUser(owner) || isUser(reader);
      allow write: if isUser(owner);
    }
  }
}
